DATABASE_URL=postgresql+asyncpg://taskflow:dev_password_only@localhost:5432/taskflow
# Optional direct (unpooled) Neon URL for Alembic migrations; normal app traffic uses DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql+asyncpg://taskflow:dev_password_only@localhost:5432/taskflow
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Redis is required only when running the optional Celery reminder worker.
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
# console adapter for development; smtp for real mail
EMAIL_BACKEND=console
EMAIL_FROM=taskflow@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_STARTTLS=true
# SMTP_USERNAME and SMTP_PASSWORD optional
